# =============================================================================
# Neon PostgreSQL
# Connection string em: console.neon.tech → seu projeto → Connection string
# =============================================================================
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# =============================================================================
# NextAuth
# Gere com: openssl rand -hex 32
# =============================================================================
AUTH_SECRET=generate_with_openssl_rand_hex_32

# =============================================================================
# URL base da aplicação (sem barra final)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Cloudinary — upload de imagens
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME: Settings > Account > Cloud name
# CLOUDINARY_UPLOAD_PRESET: Settings > Upload > Upload presets (Signing Mode: Unsigned)
# =============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# =============================================================================
# Mailtrap — e-mail transacional (V1)
# API token em: mailtrap.io > API Tokens
# =============================================================================
MAILTRAP_TOKEN=your_mailtrap_api_token
MAILTRAP_FROM_EMAIL=noreply@seudominio.com

# =============================================================================
# Mercado Pago — assinaturas (Bricks)
# MP_ACCESS_TOKEN: server-side (nunca exposto ao cliente)
# NEXT_PUBLIC_MP_PUBLIC_KEY: client-side (Bricks)
# MP_WEBHOOK_SECRET: usado para validar HMAC dos webhooks
# =============================================================================
MP_ACCESS_TOKEN=your_mp_access_token
NEXT_PUBLIC_MP_PUBLIC_KEY=your_mp_public_key
MP_WEBHOOK_SECRET=your_mp_webhook_secret

# =============================================================================
# Cron job — protege o endpoint /api/cron/subscriptions
# Gere com: openssl rand -hex 32
# =============================================================================
CRON_SECRET=generate_with_openssl_rand_hex_32

# =============================================================================
# Seed (opcional) — credenciais do admin criado pelo seed
# =============================================================================
SEED_ADMIN_EMAIL=admin@catalogo.dev
SEED_ADMIN_PASSWORD=mudar@123
